team:
  name: example-team
  timezone: Asia/Shanghai
  holidays: [] # 兼容旧配置；周末及此列表日期仍可生成和推送
  database_path: data/reports.sqlite3
  github_api_base_url: https://api.github.com
  lark_api_base_url: https://open.feishu.cn/open-apis
  github_repositories: [owner/repository]
  lark_project_ids: []
  lark_chat_ids: []
  report_keywords: [日报, 进展, 发布]
  sensitive_keywords: [薪资, 绩效]
  lark_task_search_path: /task/v2/tasklists/{tasklist_guid}/tasks
  lark_message_path: /im/v1/messages
  lark_token_path: /auth/v3/tenant_access_token/internal
  smtp:
    host: smtp.example.com
    port: 587
    username_env: DAILY_REPORT_SMTP_USERNAME
    password_env: DAILY_REPORT_SMTP_PASSWORD
    sender: reports@example.com
    recipients: [leader@example.com]
    starttls: true
    use_ssl: false
  lark_webhook_env: DAILY_REPORT_LARK_WEBHOOK
  github_token_env: DAILY_REPORT_GITHUB_TOKEN
  lark_app_id_env: DAILY_REPORT_LARK_APP_ID
  lark_app_secret_env: DAILY_REPORT_LARK_APP_SECRET
members:
  - member_id: member-001
    display_name: 张三
    github_logins: [github-example]
    lark_user_ids: [ou-example]
    github_author_names: []
